# Server port
ADK_PORT=3100

# Agent timeout in milliseconds (default: 15000)
AGENT_TIMEOUT_MS=15000

# Model override (defaults to gemini-2.5-flash)
MODEL=gemini-2.5-flash-lite

# GCP project and location (required — VertexAiSessionService verifies on startup)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Vertex AI Agent Engine ID (optional — falls back to appName parsing)
AGENT_ENGINE_ID=


# Allowed CORS origins (comma-separated, use * for development)
ALLOWED_ORIGINS=*
