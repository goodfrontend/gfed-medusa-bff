SANITY_STUDIO_PROJECT_ID=your-project-id
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_API_VERSION=2023-05-03
SANITY_API_TOKEN=

# Personalization (Redis)
REDIS_URL=

# AI personalization (OpenAI-compatible provider)
AI_ENABLED=false
AI_PROVIDER_URL=http://localhost:11434/v1
AI_API_KEY=
AI_MODEL=llama3.2:3b
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=1000

# Gemini fallback (if Groq rate-limits)
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-2.5-flash-lite

# Medusa store API (for product/category data)
MEDUSA_API_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=

# BFF client authentication (storefront shared secret)
BFF_API_KEY=

# ADK personalization
ADK_ENABLED=false
ADK_AGENT_URL=http://localhost:3100
ADK_CACHE_TTL=300
ADK_AGENT_TIMEOUT=60000
ADK_AGENT_MODE=

# ADK Pub/Sub signal pipeline (only needed when ADK_ENABLED=true)
ADK_PUBSUB_TOPIC=signal-raw
ADK_GCP_LOCATION=us-central1
ADK_ENGINE_ID=
ADK_GCP_PROJECT_ID=
ADK_GCP_PROJECT_NUMBER=

# GCP service account key (for non-GCP deploys like Render)
# Base64-encoded JSON key; decoded at runtime by GoogleAuth
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=
